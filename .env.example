# Groq bounded reviewer (zero-cost OpenAI-compatible provider)
GROQ_API_KEY=

# Optional OpenAI fallback; not required for the hackathon live path when GROQ_API_KEY is set
OPENAI_API_KEY=

# Nutrient
NUTRIENT_API_KEY=
NUTRIENT_DWS_VIEWER_API_KEY=

# Doctavian hackathon demo
DOCTAVIAN_API_KEY=
DOCTAVIAN_ACCESS_TOKEN=
DOCTAVIAN_API_BASE_URL=https://demo.api.doctavian.com

# Foxit unified developer credentials (current API model)
FOXIT_CLIENT_ID=
FOXIT_CLIENT_SECRET=
FOXIT_API_HOST=https://na1.fusion.foxit.com/pdf-services
FOXIT_ESIGN_HOST=https://na1.fusion.foxit.com
FOXIT_ESIGN_SMOKE_PDF=

# App
VERIREMIT_DATA_DIR=.data
VERIREMIT_PROVIDER_MODE=fixture
VERIREMIT_SIGNER_EMAIL=
VERIREMIT_PUBLIC_BASE_URL=http://localhost:8787
VERIREMIT_LOGGER=true

# Split deployment (set only when web and agent use different origins)
VERIREMIT_WEB_ORIGIN=
VITE_API_BASE_URL=
